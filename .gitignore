# ─── Node.js ────────────────────────────────────────────────
**/node_modules/
**/npm-debug.log*

# ─── SECRETOS — NUNCA subir al repositorio ──────────────────
**/.env
**/.env.local
**/.env.production
# (si quieres subir un ejemplo sin datos reales, crea .env.example)
Backend_NodeJS/secrets/
Backend_NodeJS/installer/mac/respaldo-cloud.conf

# ─── Outputs de compilación ─────────────────────────────────
# Recursivo a propósito: cubre Backend_NodeJS/dist, medicSystemcore/dist, y también
# ametra-sas/frontend-mac-os/medicSystemcore/dist y ametra-sas/ametra-mobile/dist sin
# tener que enumerar cada ubicación a mano.
**/dist/

# ─── Chrome de Puppeteer (se descarga al correr el servidor) ─
Backend_NodeJS/.cache/

# ─── Datos de usuarios y sesiones WhatsApp ──────────────────
Backend_NodeJS/uploads/
Backend_NodeJS/sessions/
Backend_NodeJS/.wwebjs_cache/
Backend_NodeJS/.wwebjs_auth/

# ─── JDK Java bundleado (binarios >200 MB, no van a Git) ────
# Para instalar en Mac: brew install openjdk@11
# Para Windows: los binarios quedan en la máquina de desarrollo
Backend_NodeJS/services/firmadormedico/jdk-*/

# ─── Base de datos nacional (CSV grande) ────────────────────
Backend_NodeJS/BASE_MAESTRA_NACIONAL.csv

# ─── Binarios del instalador Windows ────────────────────────
*.msi
*.exe
!medicSystemcore/dist/**/*.exe

# ─── Artifacts descargados de GitHub Actions (no van al repo) ─
AmetraOS-Backend-Mac/
AmetraOS-Desktop-Mac/
AmetraOS-Uninstall-Mac/
*.dmg
*.pkg

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
**/._*

# ─── Logs ───────────────────────────────────────────────────
*.log

# ─── Copia de referencia descartable (no es parte del proyecto) ─
verison-windows-onpremise/

# ─── ametra-sas: nuevo proyecto SaaS (mismas reglas que arriba) ─
ametra-sas/Backend_NodeJS/secrets/
ametra-sas/Backend_NodeJS/secure_storage/
ametra-sas/Backend_NodeJS/uploads/
ametra-sas/Backend_NodeJS/sessions/
ametra-sas/Backend_NodeJS/.wwebjs_cache/
ametra-sas/Backend_NodeJS/.wwebjs_auth/
ametra-sas/Backend_NodeJS/BASE_MAESTRA_NACIONAL.csv
ametra-sas/templates/
ametra-sas/*.bak

# ─── Carpeta de armado manual para instalar en clientes Mac (INSTRUCCIONES.md) ──────
# Trae un backup REAL de producción (.bak), secrets/ (firebase-service-account.json) y
# los .pkg/.dmg bajados de GitHub Actions — nada de esto es código fuente, y el .bak en
# particular tiene datos reales de pacientes. Nunca va al repo.
ultimaversion/
ultimaversion.zip
